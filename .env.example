# Copy to .env and fill in. Never commit .env.
NODE_ENV=development
PORT=4000
PUBLIC_URL=http://localhost:5173
DATABASE_URL=postgres://township:township@localhost:5440/township
# Or, instead of DATABASE_URL: PGHOST, PGPORT, PGUSER, PGPASSWORD, PGDATABASE (how the AWS setup passes them)
# DATABASE_SSL=true        # managed Postgres: TLS with the server's certificate verified
# DATABASE_SSL_CA=         # certificate bundle to verify against; defaults to Amazon RDS's, bundled
# MIGRATE_ON_START=false   # when the app's role cannot change the schema; run `npm run cli -- migrate` as the owner instead
# TRUST_PROXY=true         # behind a load balancer

# SMS (India: sender ID and templates must be DLT-approved first)
SMS_PROVIDER=msg91
MSG91_AUTH_KEY=
MSG91_OTP_TEMPLATE_ID=      # template body must contain ##otp##
MSG91_ALERT_TEMPLATE_ID=    # optional: urgent alerts to the duty manager, variable ##message##

# Razorpay (test keys work end to end with test cards and UPI)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Optional: Claude for complaint classification
ANTHROPIC_API_KEY=

# Photo storage: 'local' for development, 's3' in production (bucket in ap-south-1)
STORAGE=local
S3_BUCKET=
AWS_REGION=ap-south-1
FILE_URL_SECRET=            # 32+ random characters; signs photo links

# Push notifications: npm run cli -- vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:office@your-society.in
