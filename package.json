{
  "name": "township",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --watch server/index.js",
    "dev:web": "vite",
    "dev:fixtures": "node server/test/load-fixtures.js",
    "build": "vite build",
    "start": "NODE_ENV=production node server/index.js",
    "cli": "node server/cli.js",
    "test": "NODE_ENV=test node --test --test-concurrency=1 server/test/",
    "test:e2e": "vite build && NODE_ENV=test node --test --test-concurrency=1 e2e/",
    "load:seed": "DATABASE_URL=${LOAD_DATABASE_URL:-postgres://township:township@localhost:5440/township_load} node load/seed.js",
    "load:run": "DATABASE_URL=${LOAD_DATABASE_URL:-postgres://township:township@localhost:5440/township_load} node load/run.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@aws-sdk/client-s3": "^3.700.0",
    "@sentry/node": "^8.47.0",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "pdfkit": "^0.15.2",
    "pg": "^8.13.1",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@fontsource/inter": "^5.1.0",
    "@fontsource/noto-sans-devanagari": "^5.1.0",
    "@sentry/browser": "^8.47.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "playwright-core": "^1.49.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "vite": "^5.4.21"
  }
}
